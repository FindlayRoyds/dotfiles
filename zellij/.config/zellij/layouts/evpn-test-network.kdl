// EVPN test network: 2 panes on top, 3 in the middle, 3 on the bottom
//   1 2
//   3 4 5
//   6 7 8
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="evpn test network" {
        pane split_direction="vertical" {
            pane name="1"
            pane name="2"
        }
        pane split_direction="vertical" {
            pane name="3"
            pane name="4"
            pane name="5"
        }
        pane split_direction="vertical" {
            pane name="6"
            pane name="7"
            pane name="8"
        }
    }
}
